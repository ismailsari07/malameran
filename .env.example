# Public — safe to expose to the browser.
# The origin, with no trailing slash. Every canonical, the sitemap and the
# social image URL are built from it — if it is wrong all three are wrong
# together and silently. Must be set in all three Vercel environments.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — never expose. SUPABASE_SECRET_KEY bypasses RLS.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
# Either "name@send.malameran.com" or "Malameran <name@send.malameran.com>".
# Must be on the send. subdomain — env.ts refuses to boot otherwise, because
# automated mail on the root domain damages the reputation of the client's own
# outreach. See CLAUDE.md.
EMAIL_FROM=
TEAM_NOTIFICATION_EMAIL=info@malameran.com

# Analytics. OPTIONAL and deliberately unset until delivery: with no value here
# nothing loads and no request is made to Google. Cookieless mode, so no consent
# banner is required — but no returning visitors, no sessions, no funnels and no
# attribution either. See src/components/analytics.tsx.
#
# WARNING: setting this makes a PUBLISHED LEGAL DOCUMENT FALSE. The privacy
# policy still says no analytics provider has been selected. The policy copy in
# src/content/privacy.ts and this variable must change in the same commit.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Bot protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Abuse protection. At least 32 characters; generate with:
#   openssl rand -hex 32
# Rotating this resets every active rate-limit window. Must be set, and set to
# the same value, in all three Vercel environments.
RATE_LIMIT_IP_SALT=

# HMAC key tying the file-verification call to its request row. At least 32
# characters; generate with:
#   openssl rand -hex 32
# Its own secret on purpose — rotating the Supabase key must not invalidate
# in-flight submission tokens. Rotating THIS invalidates tokens issued in the
# last ten minutes. Must be set in all three Vercel environments.
SUBMISSION_TOKEN_SECRET=
