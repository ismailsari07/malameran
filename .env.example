# Public — safe to expose to the browser.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only — never expose. SUPABASE_SECRET_KEY bypasses RLS.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
# Either "name@send.malameran.com" or "Malameran <name@send.malameran.com>".
# Must be on the send. subdomain — env.ts refuses to boot otherwise, because
# automated mail on the root domain damages the reputation of the client's own
# outreach. See CLAUDE.md.
EMAIL_FROM=
TEAM_NOTIFICATION_EMAIL=info@malameran.com

# Bot protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Abuse protection. At least 32 characters; generate with:
#   openssl rand -hex 32
# Rotating this resets every active rate-limit window. Must be set, and set to
# the same value, in all three Vercel environments.
RATE_LIMIT_IP_SALT=

# HMAC key tying the file-verification call to its request row. At least 32
# characters; generate with:
#   openssl rand -hex 32
# Its own secret on purpose — rotating the Supabase key must not invalidate
# in-flight submission tokens. Rotating THIS invalidates tokens issued in the
# last ten minutes. Must be set in all three Vercel environments.
SUBMISSION_TOKEN_SECRET=
